{
  "name": "keypress-notifications",
  "displayName": "Keypress Notifications",
  "description": "Simple VS Code extension that shows notifications when you execute common multi-key combinations (Ctrl+C, Ctrl+Shift+P, etc.).",
  "version": "1.1.0",
  "license": "Proprietary",
  "publisher": "VijayGangatharan",
  "icon": "logo.png",
  "author": {
    "name": "Vijay Gangatharan",
    "email": "vijayanand431@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vijay431/keypress-notifications.git"
  },
  "bugs": {
    "url": "https://github.com/Vijay431/keypress-notifications/issues"
  },
  "homepage": "https://github.com/Vijay431/keypress-notifications#readme",
  "keywords": [
    "vscode",
    "extension",
    "keypress",
    "notifications",
    "clipboard",
    "productivity",
    "typescript",
    "enterprise"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "node": ">=22.13.0 <25.0.0",
    "vscode": "^1.102.0",
    "pnpm": ">=10"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "keypress-notifications.showOutputChannel",
        "title": "Show Status",
        "category": "Keypress Notifications",
        "icon": "$(output)"
      },
      {
        "command": "keypress-notifications.enable",
        "title": "Enable",
        "category": "Keypress Notifications"
      },
      {
        "command": "keypress-notifications.disable",
        "title": "Disable",
        "category": "Keypress Notifications"
      }
    ],
    "configuration": {
      "title": "Keypress Notifications",
      "properties": {
        "keypress-notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Keypress Notifications extension"
        },
        "keypress-notifications.minimumKeys": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Minimum number of keys in combination to show notification"
        },
        "keypress-notifications.excludedCommands": {
          "type": "array",
          "default": [],
          "description": "Commands to exclude from notifications"
        },
        "keypress-notifications.showCommandName": {
          "type": "boolean",
          "default": false,
          "description": "Whether to show the command name in notifications"
        },
        "keypress-notifications.logLevel": {
          "type": "string",
          "default": "info",
          "enum": ["debug", "info", "warn", "error"],
          "description": "Log level for Keypress Notifications extension"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && keypress-notifications.enabled",
          "command": "keypress-notifications.showOutputChannel",
          "group": "9_cutcopypaste@3"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "packageManager": "pnpm@11.1.3",
  "vsce": {
    "baseImageUrl": "./logo.png",
    "dependencies": true
  },
  "ovsx": {
    "namespace": "VijayGangatharan",
    "baseImageUrl": "./logo.png",
    "dependencies": true
  },
  "all-contributors": {
    "projectName": "keypress-notifications",
    "projectOwner": "Vijay431",
    "repoType": "github",
    "repoHost": "https://github.com",
    "files": [
      "README.md"
    ],
    "imageSize": 100,
    "commit": false,
    "commitType": "docs",
    "contributorsPerLine": 7,
    "contributors": [
      {
        "login": "Vijay431",
        "name": "Vijay Gangatharan",
        "avatar_url": "https://github.com/Vijay431.png",
        "profile": "https://github.com/Vijay431",
        "contributions": [
          "code",
          "doc",
          "design",
          "infra",
          "maintenance"
        ]
      },
      {
        "login": "claude-anthropic",
        "name": "Claude (Anthropic)",
        "avatar_url": "https://avatars.githubusercontent.com/u/76263028",
        "profile": "https://claude.ai",
        "contributions": [
          "code",
          "doc",
          "test",
          "review"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsx esbuild.config.ts --production",
    "build": "tsx esbuild.config.ts",
    "watch": "tsx esbuild.config.ts --watch",
    "package": "vsce package",
    "package:openvsx": "ovsx package",
    "publish": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:lockfile": "pnpm install --frozen-lockfile",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test": "rm -rf dist && pnpm run build && pnpm run create-minimal && tsc -p ./tsconfig.test.json && node ./dist/test/e2e/runE2ETest.js",
    "test:full": "rm -rf dist && pnpm run build && tsc -p ./tsconfig.test.json && SKIP_OPTIMIZATION=true node ./dist/test/e2e/runE2ETest.js",
    "test:minimal": "pnpm test",
    "test:clean": "rm -rf .vscode-test/minimal-extension .vscode-test/user-data-isolated .vscode-test/user-data-dev",
    "test:quick": "pnpm run build && pnpm test",
    "create-minimal": "tsx scripts/create-minimal-extension.ts",
    "clean": "rm -rf dist out"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^11.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "all-contributors-cli": "^6.26.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "mocha": "^11.7.1",
    "ovsx": "^0.10.12",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
